* text=auto

# Unity YAML: merge as text, keep LF out of the way
*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.meta      text eol=lf
*.mat       text eol=lf
*.spriteatlas text eol=lf
*.anim      text eol=lf
*.controller text eol=lf

*.cs   text diff=csharp
*.md   text
*.ps1  text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.psd binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.dll binary
